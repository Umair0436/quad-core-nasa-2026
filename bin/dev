#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
api_pid=""
web_pid=""
cleanup() {
  trap - EXIT INT TERM
  if [[ -n "$web_pid" ]]; then kill "$web_pid" 2>/dev/null || true; fi
  if [[ -n "$api_pid" ]]; then kill "$api_pid" 2>/dev/null || true; fi
  wait 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ ! -d "$project_root/frontend/node_modules" ]]; then
  echo "Install frontend dependencies first: cd frontend && npm ci"
  exit 1
fi

cd "$project_root/backend"
bundle check >/dev/null || { echo "Install backend dependencies first: cd backend && bundle install"; exit 1; }
bundle exec rails server -b 127.0.0.1 -p 3100 &
api_pid=$!
cd "$project_root/frontend"
# Execute Vite directly so the PID belongs to the server, not an npm wrapper.
node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5174 --strictPort &
web_pid=$!
echo "LUNA-01: http://localhost:5174 (Rails API: http://127.0.0.1:3100)"
wait -n "$api_pid" "$web_pid"
