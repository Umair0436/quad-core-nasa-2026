{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && cp ../ml/functions.py lib/lunar_model.py",
  "functions": {
    "api/**/*.rb": { "includeFiles": "lib/**" }
  },
  "rewrites": [
    { "source": "/outpost/:astronaut", "destination": "/index.html" },
    { "source": "/briefing/:astronaut", "destination": "/index.html" }
  ]
}
